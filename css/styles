:root {
    --bg-main: #090d16;
    --bg-card: #121929;
    --bg-card-hover: #182238;
    --bg-panel: #0e1422;
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --accent-cyan: #00d2ff;
    --accent-blue: #3a7bd5;
    --accent-green: #10b981;
    --border-color: rgba(255, 255, 255, 0.08);
    --radius: 14px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-main);
    background-image: 
        radial-gradient(circle at 15% 10%, rgba(0, 210, 255, 0.08), transparent 35%),
        radial-gradient(circle at 85% 20%, rgba(58, 123, 213, 0.08), transparent 35%);
    color: var(--text-primary);
    line-height: 1.5;
    min-height: 100vh;
    padding-bottom: 60px;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

header {
    text-align: center;
    padding: 48px 20px 32px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 30px;
}

.brand-badge {
    display: inline-block;
    background: rgba(0, 210, 255, 0.1);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 210, 255, 0.25);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
}

header h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    background: linear-gradient(90deg, #ffffff 0%, #00d2ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 10px;
}

header p.subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin-bottom: 24px;
}

.trust-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
}

.trust-pill {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
    display: flex;
    align-items: center;
    gap: 8px;
}

.trust-pill span {
    color: var(--accent-cyan);
}

.filters-panel {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 22px;
    margin-bottom: 28px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}

.filters-top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    margin-bottom: 20px;
}

@media (max-width: 768px) {
    .filters-top {
        grid-template-columns: 1fr;
    }
}

.search-box input, .sort-select {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 13px 16px;
    border-radius: 10px;
    font-size: 0.95rem;
    outline: none;
}

.search-box input:focus {
    border-color: var(--accent-cyan);
}

.price-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    background: var(--bg-card);
    border-radius: 10px;
    border: 1px solid var(--border-color);
    margin-bottom: 18px;
}

.price-inputs {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.price-inputs label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
}

.price-input-group {
    display: flex;
    align-items: center;
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 6px 10px;
}

.price-input-group span {
    color: var(--accent-cyan);
    font-size: 0.85rem;
    font-weight: 700;
    margin-right: 4px;
}

.price-input-group input {
    width: 75px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9rem;
    outline: none;
}

.quick-ranges, .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.range-btn {
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 7px 13px;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.range-btn:hover, .range-btn.active {
    background: rgba(0, 210, 255, 0.15);
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
}

.cat-tab {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.cat-tab.active {
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
    color: #060911;
    border-color: transparent;
    font-weight: 700;
}

.results-info {
    margin-bottom: 18px;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 18px;
}

.product-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s, border-color 0.2s, background 0.2s;
}

.product-card:hover {
    transform: translateY(-3px);
    background: var(--bg-card-hover);
    border-color: rgba(0, 210, 255, 0.35);
}

.card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
}

.badge-cat {
    font-size: 0.73rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-cyan);
    background: rgba(0, 210, 255, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
}

.badge-cond {
    font-size: 0.73rem;
    font-weight: 600;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.06);
    padding: 4px 10px;
    border-radius: 6px;
}

.product-title {
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
}

.product-details {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 18px;
}

.card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--border-color);
    gap: 12px;
}

.price-label {
    font-size: 0.72rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    display: block;
}

.price-value {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
}

.price-value span {
    color: var(--accent-cyan);
    font-size: 0.95rem;
    margin-right: 2px;
}

.btn-wa {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.35);
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
}

.btn-wa:hover {
    background: var(--accent-green);
    color: #051b11;
}

.empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 50px 20px;
    background: var(--bg-card);
    border-radius: var(--radius);
    border: 1px dashed var(--border-color);
    color: var(--text-secondary);
}

footer {
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid var(--border-color);
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
}